# ─── Auth0 (optional) ────────────────────────────────────────────────────────
# Set these to enable "Continue with Auth0" on the login screen and to make
# the API accept Auth0 RS256 tokens. Leave blank to run on local accounts only.
#
# Client-side (must be VITE_-prefixed so Vite inlines them into the build):
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=your_spa_client_id
# Optional: an Auth0 API "Identifier" (audience). When set, the SPA requests an
# access token for it and the server validates that audience. When omitted, the
# ID token is used and the server validates audience = client id.
VITE_AUTH0_AUDIENCE=

# Server-side validation. These can mirror the VITE_ values above; if only the
# VITE_ ones are set the server falls back to them automatically.
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=your_spa_client_id
AUTH0_AUDIENCE=
# Comma-separated emails that should be granted L4 (admin) on first sign-in.
AUTH0_ADMIN_EMAILS=
# Tier/role assigned to other Auth0 users on first sign-in (defaults: L4 / Auditor).
AUTH0_DEFAULT_TIER=L4
AUTH0_DEFAULT_ROLE=Auditor

# ─── Local auth ──────────────────────────────────────────────────────────────
# JWT signing secret for local (username/password) sessions. If unset, one is
# generated and persisted in the database on first boot.
TRUSTSFER_JWT_SECRET=

# ─── Storage ─────────────────────────────────────────────────────────────────
# SQLite file path. On Vercel/Lambda this defaults to /tmp (ephemeral). Point it
# at a mounted volume for durable persistence.
TRUSTSFER_DB=
